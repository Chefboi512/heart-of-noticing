# Cloudflare Pages headers.
# HTML already gets "max-age=0, must-revalidate" from Cloudflare by default.

# CSS/JS filenames carry a content hash, so they can be cached for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts rarely change; images keep their names when swapped, so they revalidate after a day
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
